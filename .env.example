# ============================================================================
# AEGIS - Example environment. Copy to .env and adjust. NEVER commit .env
# ============================================================================

# --- Kafka / Redpanda -------------------------------------------------------
# Host-side listener (your Python code runs on the host, not in Docker)
AEGIS_KAFKA_BOOTSTRAP=localhost:19092
AEGIS_SCHEMA_REGISTRY_URL=http://localhost:18081

# --- Object storage (MinIO, S3-compatible) ----------------------------------
AEGIS_S3_ENDPOINT=http://localhost:9000
AEGIS_S3_ACCESS_KEY=aegis_dev_access
AEGIS_S3_SECRET_KEY=aegis_dev_secret_change_me
AEGIS_S3_REGION=eu-west-3
AEGIS_LAKE_BUCKET=aegis-lakehouse

# --- Metadata database ------------------------------------------------------
AEGIS_PG_HOST=localhost
AEGIS_PG_PORT=15432
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis_dev_password_change_me
AEGIS_PG_DATABASE=aegis

# --- Iceberg catalog --------------------------------------------------------
AEGIS_CATALOG_NAME=aegis
AEGIS_CATALOG_URI=postgresql+psycopg2://aegis:aegis_dev_password_change_me@localhost:15432/aegis

# --- Local storage ----------------------------------------------------------
# Where collected files land. Keep this OUTSIDE any cloud-synced folder
# (OneDrive, Dropbox): the data is regenerable, and syncing it wastes quota
# and CPU. On Linux/CI the default './data' is fine.
AEGIS_DATA_DIR=C:/aegis-data/lake

# --- Runtime ----------------------------------------------------------------
AEGIS_ENV=local
AEGIS_LOG_LEVEL=INFO
