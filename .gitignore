# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- Secrets & config ---
.env
.env.local
*.pem
*.key
secrets/

# --- Data (must NEVER be committed) ---
data/
warehouse/
*.parquet
*.duckdb
*.duckdb.wal
logs/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/

# --- Node / web ---
node_modules/
.next/
out/

# --- IDE / OS ---
# .vscode/settings.json IS committed: it points VS Code at the venv, which
# lives outside this folder and cannot be auto-discovered. Everything else
# under .vscode/ is personal and stays ignored.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# --- ML ---
mlruns/
*.pkl
*.joblib

# --- Terraform ---
# State holds every resource ID and public IP of the honeypot, and tfvars holds
# your home IP address and OCIDs. Neither belongs in a public repository.
# .terraform.lock.hcl IS committed: it pins the provider checksums.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
